# Copy to .env and fill in. .env is gitignored. Never commit real values.

# Gemini (agent-backend). From Google AI Studio / the hackathon credits.
# Role-specific model IDs live in agent-backend/models.py.
GEMINI_API_KEY=

# Backend
BACKEND_PORT=8787
BACKEND_HOST=127.0.0.1

# Shopify Catalog. Optional. Blank = anonymous, lowest rate limit (fine for the demo).
SHOPIFY_CATALOG_CLIENT_ID=
SHOPIFY_CATALOG_CLIENT_SECRET=
# Agent profile URL sent to the Catalog. Shopify's sample works for the hackathon.
UCP_AGENT_PROFILE=https://shopify.dev/ucp/agent-profiles/examples/2026-08-25/valid-with-capabilities.json

# Shopper context
SHOP_COUNTRY=US
SHOP_CURRENCY=USD

# Companion screen (Vite reads VITE_* at build time)
VITE_BACKEND_URL=http://localhost:8787
